\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Attribute injection ablation in FATR{}. We compare full tool cards with finance tags against a variant without attribute injection. Injection slightly reduces tool invocation (\textsc  {TIR}\xspace  ) under stricter acceptability checks, but it improves execution success conditioned on tool use (\textsc  {CER}\xspace  ) and reduces mismatch rates (\textsc  {TMR}\xspace  {}, \textsc  {IMR}\xspace  {}, \textsc  {DMR}\xspace  {}).}}{8}{figure.caption.18}\protected@file@percent }
\newlabel{fig:ablation_injection}{{5}{8}{Attribute injection ablation in \methodname {}. We compare full tool cards with finance tags against a variant without attribute injection. Injection slightly reduces tool invocation (\tir ) under stricter acceptability checks, but it improves execution success conditioned on tool use (\cer ) and reduces mismatch rates (\tmr {}, \imr {}, \dmr {})}{figure.caption.18}{}}
